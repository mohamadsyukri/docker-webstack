# Copy to .env — bin/setup.sh does that for you and fills in the two passwords.

TIMEZONE=Asia/Kuala_Lumpur
HTTP_PORT=80

# Where your code lives on this machine. Mounted at /var/www/projects in every container.
PROJECTS_DIR=./projects

# Xdebug: off | debug | develop | coverage. Recreate the PHP containers after changing it:
#   docker compose up -d --force-recreate php83
XDEBUG_MODE=off

# Extra services to start, comma-separated. bin/new-site.sh adds php84 when a site needs it.
COMPOSE_PROFILES=

# Generated by bin/setup.sh on first run. Projects use it as REDIS_PASSWORD in their .env.
REDIS_PASSWORD=

# mysql-local: a separate container (not in compose.yaml), created by bin/setup.sh if missing.
MYSQL_ROOT_PASSWORD=
MYSQL_IMAGE=mysql:8.4.10
MYSQL_PORT=3306

# Images for bin/node.sh (bin/playwright.sh picks the image matching each project's Playwright).
NODE_IMAGE=node:22-bookworm-slim
